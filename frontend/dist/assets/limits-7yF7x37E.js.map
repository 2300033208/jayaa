{
  "schema_version": 1,
  "fields": {
    "environment.latitude_deg": { "label": "Latitude", "unit": "°", "min": -90, "max": 90 },
    "environment.longitude_deg": { "label": "Longitude", "unit": "°", "min": -180, "max": 180 },
    "environment.elevation_m": { "label": "Elevation", "unit": "m", "min": -500, "max": 9000 },
    "environment.terrain_relief_m": { "label": "Terrain relief", "unit": "m", "min": 0, "max": 500 },
    "environment.terrain_density_kg_m3": { "label": "Terrain density", "unit": "kg/m³", "min": 0, "max": 4000 },
    "environment.terrain_density_assumed_kg_m3": { "label": "Assumed terrain density", "unit": "kg/m³", "min": 0, "max": 4000 },

    "bodies.*.density_contrast_kg_m3": { "label": "Density contrast", "unit": "kg/m³", "min": 10, "max": 20000, "positive": true },
    "bodies.*.mass_kg": { "label": "Mass", "unit": "kg", "min": 1e6, "max": 1e15, "positive": true },
    "bodies.*.depth_m": { "label": "Depth", "unit": "m", "min": 1, "max": 20000, "positive": true },
    "bodies.*.x_m": { "label": "Position X", "unit": "m", "min": -50000, "max": 50000 },
    "bodies.*.y_m": { "label": "Position Y", "unit": "m", "min": -50000, "max": 50000 },

    "sensor.reference_frequency_hz": { "label": "Reference frequency", "unit": "Hz", "min": 1e9, "max": 2e15, "positive": true },
    "sensor.bbr_sensitivity_per_k": { "label": "Blackbody sensitivity", "unit": "K⁻¹", "min": 0, "max": 1e-14 },
    "sensor.measurement_interval_s": { "label": "Averaging time per station", "unit": "s", "min": 1, "max": 604800, "positive": true },
    "sensor.stability_1s": { "label": "Sensor stability", "unit": "", "min": 1e-19, "max": 1e-10, "positive": true },
    "sensor.systematic_uncertainty": { "label": "Systematic uncertainty per set-up", "unit": "", "min": 0, "max": 1e-11 },
    "sensor.uptime_percent": { "label": "Clock uptime", "unit": "%", "min": 5, "max": 100, "positive": true },
    "sensor.reference_distance_km": { "label": "Reference distance", "unit": "km", "min": 0, "max": 5000 },

    "noise.measurement_noise": { "label": "Measurement noise", "unit": "", "min": 0, "max": 1e-14 },
    "noise.frequency_drift_per_hour": { "label": "Frequency drift", "unit": "h⁻¹", "min": -1e-15, "max": 1e-15 },
    "noise.environmental_noise": { "label": "Environmental noise", "unit": "", "min": 0, "max": 1e-14 },
    "noise.temperature_fluctuation_k": { "label": "Temperature fluctuation", "unit": "K", "min": 0, "max": 10 },
    "noise.vibration_m": { "label": "Vibration", "unit": "m", "min": 0, "max": 1 },
    "noise.station_height_uncertainty_m": { "label": "Station height uncertainty", "unit": "m", "min": 0, "max": 1 },
    "noise.tide_residual_percent": { "label": "Tide residual", "unit": "%", "min": 0, "max": 100 },
    "noise.seed": { "label": "Random seed", "unit": "", "min": 0, "max": 4294967295, "integer": true },

    "survey.width_m": { "label": "Survey width", "unit": "m", "min": 10, "max": 50000, "positive": true },
    "survey.length_m": { "label": "Survey length", "unit": "m", "min": 10, "max": 50000, "positive": true },
    "survey.spacing_m": { "label": "Resolution", "unit": "m", "min": 1, "max": 10000, "positive": true },
    "survey.sensor_height_m": { "label": "Sensor height", "unit": "m", "min": 0.1, "max": 1000, "positive": true },
    "survey.setup_time_s": { "label": "Station set-up time", "unit": "s", "min": 0, "max": 604800 },

    "inversion.source_count": { "label": "Sources to fit", "unit": "", "min": 1, "max": 3, "integer": true },
    "inversion.bootstrap_samples": { "label": "Bootstrap samples", "unit": "", "min": 20, "max": 1000, "integer": true }
  },
  "bodies": { "min_count": 1, "max_count": 3 },
  "survey": { "max_points": 100000, "min_points_per_axis": 3 },
  "name": { "max_length": 120 }
}
